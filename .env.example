# =============================================================================
# Frontend environment template — copy to `.env.local` (Vite picks it up
# automatically) and fill in. Never commit the real .env.local.
#
# Vite only exposes vars prefixed with VITE_ to the bundle.
# =============================================================================

# Base URL of the backend API. No trailing slash.
#   Local dev:  http://localhost:5000
#   Production: https://your-backend-host.example.com
VITE_BACKEND_URL=http://localhost:5000

# Same Google OAuth Web Client ID used by the server (GOOGLE_CLIENT_ID).
# Required for the Google sign-in button to render.
VITE_GOOGLE_CLIENT_ID=
